# VCS / CI
.git
.github

# Dependencies (installed fresh inside the image)
**/node_modules

# Build output and caches (rebuilt inside the image)
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo

# Secrets and local env files (pass at runtime with --env-file)
**/.env
**/.env.*
!**/.env.example

# Logs
**/*.log
**/npm-debug.log*
**/pnpm-debug.log*

# Editor / OS junk
.vscode
.idea
.DS_Store

# Docker files don't need to be in the build context
**/Dockerfile*
.dockerignore