{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "load:openapi": {
      "env": [
        "NEXT_PUBLIC_NEKOMI_API_URL"
      ],
      "inputs": [
        "orval.config.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "load:openapi"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist"
      ],
      "env": [
        "API_KEY_SK",
        "NEXT_PUBLIC_TELEGRAM_BOT_URL",
        "NEXT_PUBLIC_NEKOMI_NEXTJS_URL",
        "NEXT_PUBLIC_NEKOMI_API_URL",
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "load:openapi"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "load:openapi"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}